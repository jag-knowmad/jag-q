{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(self)" }]
    },
    {
      "source": "/cards/(.*).mind",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
